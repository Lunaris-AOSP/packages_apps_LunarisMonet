-    private fun getCurrentSettings(): JSONObject {
-        return try {
-            val currentJson = Settings.Secure.getString(
-                activity?.contentResolver,
-                Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES
