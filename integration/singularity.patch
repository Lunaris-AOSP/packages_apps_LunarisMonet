-            JSONObject("{}")
-        }
-    }
-
-    private fun applySettings(json: JSONObject) {
-        try {
-            json.put("_applied_timestamp", System.currentTimeMillis())
-            Settings.Secure.putString(
-                activity?.contentResolver,
-                Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES,
-                json.toString()
-            )
-        } catch (e: Exception) {
-            e.printStackTrace()
-        }
-    }
